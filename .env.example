POSTGRES_USER=app_user
# Use URL-safe credentials so they can also appear in the database URLs.
POSTGRES_PASSWORD=postgress
POSTGRES_DB=app_db

# =============================================================================
# Development — web and API running on your machine.
# Both WEB_URL and BASE_URL are on localhost so cookies work without HTTPS.
# =============================================================================
NODE_ENV=development
PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
BASE_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/trpc
DATABASE_URL=postgres://app_user:postgress@localhost:5432/app_db

# Docker Compose derives the container DB URL from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.

# =============================================================================
# Production — configure these in your hosting provider (e.g. Render, Fly.io).
#
# IMPORTANT — same registrable domain requirement:
#   SameSite=Lax cookies (the only mode supported) are sent by browsers only
#   when the initiating page and the cookie's domain share the same registrable
#   domain (e.g. example.com). Therefore:
#
#     WEB_URL  = https://<web-domain>           (e.g. https://forms.example.com)
#     BASE_URL = https://api.<web-domain>       (e.g. https://api.example.com)
#
#   "example.com" is the registrable domain in both cases — the cookie will be
#   sent. If WEB_URL and BASE_URL use *different* registrable domains (e.g.
#   forms.example.com vs my-api.render.com), the app will NOT work: the API
#   will log a loud warning at startup and cookies will be blocked by browsers.
#
#   OAuth redirect URIs must use the API's public URL (BASE_URL), not WEB_URL:
#     https://api.<web-domain>/api/auth/callback/google
#     https://api.<web-domain>/api/auth/callback/github
#
# Uncomment and fill in the values below for production.
# =============================================================================
# NODE_ENV=production
# PORT=<provided-by-host>
# WEB_URL=https://<web-domain>
# BASE_URL=https://api.<web-domain>
# NEXT_PUBLIC_WEB_URL=https://<web-domain>
# NEXT_PUBLIC_API_URL=https://api.<web-domain>/trpc
# Set DATABASE_URL to the connection string from your DB provider (e.g. Neon).
# Keep the sslmode=require option if your provider requires it.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Optional: additional trusted origins beyond WEB_URL, comma-separated.
# Use this if you have a staging or preview deployment that needs to access
# the same API. Each entry must be a full HTTPS origin without wildcards.
# Example: TRUSTED_ORIGINS=https://preview.<web-domain>,https://staging.<web-domain>
TRUSTED_ORIGINS=

BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
RESPONDENT_COOKIE_SECRET=replace_with_a_different_secret_of_at_least_32_characters
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# Used by Better Auth verification emails
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend
EMAIL_FROM=noreply@kunalmadoliya.me
LOGGER_LEVEL=info
SKIP_ENV_VALIDATION=
# Leave blank to keep Next.js environment validation enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
INNGEST_DEV=http://localhost:8288
# Production Inngest Cloud values are injected into the API container by Compose.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# =============================================================================
# Razorpay Payments (Credit purchases)
# Optional for startup; required to create orders and verify payments/webhooks.
# Webhook URL to configure in Razorpay dashboard:
#   https://<api-domain>/api/webhooks/razorpay
# Active webhook events: order.paid, payment.captured
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# =============================================================================
# Contact Form Mailer (via Resend HTTPS API)
# Optional for startup; required to receive messages submitted via /contact.
# Note: Completely isolated from Better Auth's RESEND_API_KEY above.
# When using onboarding@resend.dev, Resend delivers only to the account owner.
# =============================================================================
CONTACT_EMAIL=your-inbox@example.com
CONTACT_RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=contact@kunalmadoliya.me
