POSTGRES_USER=app_user
# Use a URL-safe value so it can also appear in DATABASE_URL without encoding errors.
POSTGRES_PASSWORD=replace_with_url_safe_password
POSTGRES_DB=app_db

DATABASE_URL=postgres://app_user:replace_with_url_safe_password@postgresdb:5432/app_db
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Keep these API origins identical; WEB_URL is the browser origin allowed by CORS.
BETTER_AUTH_URL=http://localhost:4000
BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# This URL is embedded in browser code at build time and must end in /trpc.
NEXT_PUBLIC_API_URL=http://localhost:4000/trpc
# The current API/logger Zod schemas accept "prod", not Node's conventional "production".
NODE_ENV=prod
PORT=4000
LOGGER_LEVEL=info
SKIP_ENV_VALIDATION=
# Leave blank to keep Next.js environment validation enabled.