POSTGRES_USER=app_user
# Use URL-safe credentials so they can also appear in the database URLs.
POSTGRES_PASSWORD=postgress
POSTGRES_DB=app_db

# Development: web and API running on your machine.
NODE_ENV=development
PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
BASE_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/trpc
DATABASE_URL=postgres://app_user:postgress@localhost:5432/app_db

# Docker Compose derives the container DB URL from POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.

# Production: configure the Render API and Vercel web project with these values.
# NODE_ENV=production
# WEB_URL=https://ftheform.kunalmadoliya.me
# BASE_URL=https://<RENDER_API_URL>
# NEXT_PUBLIC_WEB_URL=https://ftheform.kunalmadoliya.me
# NEXT_PUBLIC_API_URL=https://<RENDER_API_URL>/trpc
# Set DATABASE_URL to the connection string copied from Neon (keep its sslmode=require option).
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
RESPONDENT_COOKIE_SECRET=replace_with_a_different_secret_of_at_least_32_characters
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=FTHEFORM <no-reply@example.com>
LOGGER_LEVEL=info
SKIP_ENV_VALIDATION=
# Leave blank to keep Next.js environment validation enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local Inngest development server URL. Do not set this in production.
INNGEST_DEV=http://localhost:8288
# Production Inngest Cloud values are injected into the API container by Compose.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
