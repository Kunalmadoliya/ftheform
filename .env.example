POSTGRES_USER=app_user
# Use URL-safe credentials so they can also appear in the database URLs.
POSTGRES_PASSWORD=postgress
POSTGRES_DB=app_db

# Development API on the host connects to the published PostgreSQL port.
DEV_DATABASE_URL=postgres://app_user:postgress@localhost:5432/app_db
# Production API and migrations run in Compose and connect to the postgresdb service.
PROD_DATABASE_URL=postgres://app_user:postgress@postgresdb:5432/app_db_prod
# Provision the separate production database once before starting the production stack:
# docker compose exec postgresdb sh -c 'createdb -U "$POSTGRES_USER" app_db_prod'
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
RESPONDENT_COOKIE_SECRET=replace_with_a_different_secret_of_at_least_32_characters
# Set CORS_ORIGINS and TRUSTED_ORIGINS to comma-separated web origins in deployments.
BETTER_AUTH_URL=http://localhost:4000
BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
RESEND_API_KEY=replace_with_resend_api_key
EMAIL_FROM=FTHEFORM <no-reply@example.com>
# This URL is embedded in browser code at build time and must end in /trpc.
NEXT_PUBLIC_API_URL=http://localhost:4000/trpc
NODE_ENV=development
PORT=4000
LOGGER_LEVEL=info
SKIP_ENV_VALIDATION=
# Leave blank to keep Next.js environment validation enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local Inngest development server URL. Do not set this in production.
INNGEST_DEV=http://localhost:8288
# Production Inngest Cloud values are injected into the API container by Compose.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=