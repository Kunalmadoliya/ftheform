# =============================================================================
# API Server Environment Variables (@repo/api)
# Configure these in your hosting provider (e.g. Render Web Service).
# =============================================================================

# Server & Routing
# PORT: Provided automatically by Render in production. Required for startup.
PORT=4000
# NODE_ENV: 'development' or 'production'. Required for startup.
NODE_ENV=development
# BASE_URL: Public URL of this API. Required for startup (must use HTTPS in prod).
BASE_URL=http://localhost:4000
# WEB_URL: Public URL of the frontend web app. Required for startup (must use HTTPS in prod).
# NOTE: Must share the same registrable domain as BASE_URL for SameSite=Lax cookies to work.
WEB_URL=http://localhost:3000
# TRUSTED_ORIGINS: Optional comma-separated additional HTTPS origins (e.g. preview/staging URLs).
TRUSTED_ORIGINS=

# Database
# DATABASE_URL: PostgreSQL connection string. Required for startup.
DATABASE_URL=postgres://app_user:postgress@localhost:5432/app_db

# Security & Sessions
# BETTER_AUTH_SECRET: Secret for Better Auth session signing (min 32 chars). Required for startup.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# RESPONDENT_COOKIE_SECRET: Secret for signing respondent cookies (min 32 chars). Required for startup.
RESPONDENT_COOKIE_SECRET=replace_with_a_different_secret_of_at_least_32_characters

# Better Auth OAuth Providers
# Optional for startup; required for social login to work.
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Better Auth Email Verification
# Optional for startup; used by Better Auth verification emails.
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend
EMAIL_FROM=noreply@kunalmadoliya.me

# AI Form Generation
# Optional for startup; required to generate form fields using AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Inngest Background Jobs
# Local dev Inngest server. Do not set INNGEST_DEV in production.
INNGEST_DEV=http://localhost:8288
# Production Inngest Cloud keys. Optional for startup; required for Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Logging
# Optional; 'error' | 'info' | 'debug'. Defaults to 'debug' in dev, 'error' in prod.
LOGGER_LEVEL=info

# =============================================================================
# Razorpay Payments (Credit purchases)
# Optional for startup; required to create orders and verify payments/webhooks.
# Webhook URL to configure in Razorpay dashboard:
#   https://<api-domain>/api/webhooks/razorpay
# Active webhook events: order.paid, payment.captured
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# =============================================================================
# Contact Form Mailer (via Resend HTTPS API)
# Optional for startup; required to receive messages submitted via /contact.
# Note: Completely isolated from Better Auth's RESEND_API_KEY above.
# When using onboarding@resend.dev, Resend delivers only to the account owner.
# =============================================================================
CONTACT_EMAIL=your-inbox@example.com
CONTACT_RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=contact@kunalmadoliya.me
