  "cards": [
    {
      "dot": "cyan",
      "title": "Submission behavior",
      "items": [
        "The public form loads its published snapshot; respondents start a response and autosave drafts.",
        "On submit, the API checks publication, access, snapshot version, required answers, identity and response limits, then commits answer rows and submitted status in one transaction."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Browser input crosses into the server-side API, which derives a Better Auth session or validates a signed respondent cookie.",
        "The API and PostgreSQL are separate runtime/data boundaries; DB access is configured through DATABASE_URL."
      ]
    },
    {
      "dot": "violet",
      "title": "Other external dependencies",
      "items": [
        "Better Auth uses Google and GitHub OAuth; email verification calls Resend.",
        "Inngest runs optional background form-generation jobs; those jobs call OpenAI when configured.",
        "Deployment docs name Vercel for web, Render for API and Neon for production PostgreSQL; Compose provides local PostgreSQL."
      ]
    }
  ]
